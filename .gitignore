# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# Node / Next.js
node_modules/
.next/
out/
*.tsbuildinfo

# Tooling / editor
.hermes/
.vscode/
.DS_Store

# Env / secrets
.env
.env.local
.env.*.local

# Test artifacts
playwright-report/
test-results/

# Firebase service-account keys. These grant server-side access to the
# project; they belong in an environment variable, never in the repo.
*-firebase-adminsdk-*.json
**/serviceAccountKey.json
**/service-account*.json

# Android release signing. The keystore IS the app's identity: anyone with it
# can publish an update that Android trusts as genuine, and losing it means no
# further updates to an already-published app are possible at all.
*.jks
*.keystore
mobile/android/key.properties
